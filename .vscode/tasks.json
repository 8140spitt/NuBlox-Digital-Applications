{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NuBlox: Logged Terminal",
      "type": "process",
      "command": "${workspaceFolder}/scripts/start-logged-terminal.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "NuBlox: Validate System",
      "type": "process",
      "command": "/bin/zsh",
      "args": ["${workspaceFolder}/scripts/validate-system.sh"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": true
      }
    }
  ]
}
