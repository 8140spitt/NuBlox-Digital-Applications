# NuBlox application database
DATABASE_URL=mysql://nublox:nublox@127.0.0.1:3306/nublox

# mysql2 pool sizing. Keep deliberately small per application process unless load testing proves otherwise.
DB_POOL_MAX=10

# Better Auth server origin and secret. Generate a strong production secret; never commit it.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret

# Development/integration only. Production must use a real transactional email provider adapter.
EMAIL_DELIVERY_MODE=console

# Keep false while terminal logging is enabled. Set true only for deliberate local manual
# verification/reset/invitation link testing, then disable it and clear any affected logs.
EMAIL_CONSOLE_INCLUDE_SECRETS=false
