# NuBlox canonical database connection.
# For local development, copy the working DATABASE_URL from appv1/.env so V1 and V2
# use the same canonical NuBlox schema. Do not commit real credentials.
DATABASE_URL=

# Better Auth server origin and secret. Replace the development placeholder with
# a strong secret before using any non-local environment.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173

# Development only. Production must use a transactional email adapter.
EMAIL_DELIVERY_MODE=console
